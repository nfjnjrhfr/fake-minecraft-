# SGPT configuration
# Required: your Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Optional
PORT=3000
SGPT_MODEL=claude-opus-5
SGPT_EFFORT=high
SGPT_MAX_TOKENS=64000
# Set to 0 to disable server-side refusal fallbacks
SGPT_FALLBACKS=1
# Directory for stored conversations
SGPT_DATA_DIR=./data/conversations
