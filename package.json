{
  "name": "minicraft-ai",
  "version": "1.0.0",
  "description": "兩個從零手寫、零相依的 AI：Double DQN 自我學習挖礦，以及 mini-GPT 語言模型",
  "type": "module",
  "scripts": {
    "test": "node tests/run.mjs && node tests/gpt.mjs",
